{
  "name": "idea-board",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n convex,web,claude,gate,stt -c blue,green,magenta,yellow,cyan \"bun run convex\" \"bun run web\" \"bun run worker\" \"bun run gate\" \"bun run stt\"",
    "convex": "convex dev --tail-logs disable",
    "web": "vite",
    "worker": "bun worker/ai-worker.ts",
    "typecheck": "tsc -p . --noEmit && tsc -p convex --noEmit",
    "gate": "bun gate/gate.ts",
    "stt": "bun stt/server.ts",
    "stt:setup": "bash stt/setup.sh"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.286",
    "@convex-dev/prosemirror-sync": "^0.2.6",
    "@floating-ui/dom": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-character-count": "^3.31.4",
    "@tiptap/extension-highlight": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/extension-task-item": "^3.31.4",
    "@tiptap/extension-task-list": "^3.31.4",
    "@tiptap/extension-text-align": "^3.31.4",
    "@tiptap/extension-typography": "^3.31.4",
    "@tiptap/markdown": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@tiptap/suggestion": "^3.31.4",
    "convex": "^1.46.0",
    "diff": "^9.0.0",
    "lucide-react": "^1.49.0",
    "marked": "^18.0.14",
    "prosemirror-collab": "1.3.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "wouter": "^3.13.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/diff": "^8.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
